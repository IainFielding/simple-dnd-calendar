<div>
    <div class="sdc-bar" aria-hidden="true"></div>
    <time class="sdc-time"></time>
    <div class="sdc-visual">
        <div class="sdc-season" style="background-image: {{ seasonGradient }}; background-size: {{ seasonWidth }}px 100%">
            <svg class="sdc-season-frame" viewBox="0 0 460 26" preserveAspectRatio="none" aria-hidden="true">
                <polyline points="1,0 29,25 431,25 459,0"/>
                <polyline class="inner" points="7,0 32,21.5 428,21.5 453,0"/>
            </svg>
            <span class="sdc-date"></span>
        </div>
        <div class="sdc-corner sdc-left">
            <i class="sdc-season-icon" hidden></i>
        </div>
        <div class="sdc-corner sdc-right">
            <i class="sdc-festival-icon fa-solid fa-star-christmas" hidden></i>
        </div>
        <div class="sdc-sky">
            <svg viewBox="0 0 {{ sky.width }} {{ sky.height }}" width="{{ sky.width }}" height="{{ sky.height }}" aria-hidden="true">
                <defs>
                    <radialGradient id="sdc-bowl-fill" gradientUnits="userSpaceOnUse" cx="{{ sky.cx }}" cy="{{ sky.cy }}" r="{{ sky.bowl }}">
                        <stop offset="0.55" stop-color="#2a2d6c"/>
                        <stop offset="1" stop-color="#0a0b20"/>
                    </radialGradient>
                    <radialGradient id="sdc-day-fill" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="{{ sky.wheel }}">
                        <stop offset="0" stop-color="#fff6d6"/>
                        <stop offset="0.6" stop-color="#ffc874"/>
                        <stop offset="1" stop-color="#e9813f"/>
                    </radialGradient>
                    <radialGradient id="sdc-night-fill" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="{{ sky.wheel }}">
                        <stop offset="0" stop-color="#b9b5ff"/>
                        <stop offset="0.6" stop-color="#6c63e0"/>
                        <stop offset="1" stop-color="#2f2a8e"/>
                    </radialGradient>
                    <clipPath id="sdc-bowl-clip"><path d="{{ bowlPath }}"/></clipPath>
                </defs>

                {{!-- The bowl of the sky --}}
                <path class="sdc-bowl" d="{{ bowlPath }}" fill="url(#sdc-bowl-fill)"/>
                <g clip-path="url(#sdc-bowl-clip)">
                    <circle class="sdc-bowl-ring" cx="{{ sky.cx }}" cy="{{ sky.cy }}" r="118"/>
                    <circle class="sdc-bowl-ring dashed" cx="{{ sky.cx }}" cy="{{ sky.cy }}" r="139"/>
                    {{#each stars}}<circle class="sdc-star" cx="{{ x }}" cy="{{ y }}" r="{{ r }}" opacity="{{ o }}"/>{{/each}}
                </g>

                {{!-- The day wheel, drawn about its own centre and turned through the day --}}
                <g transform="translate({{ sky.cx }} {{ sky.cy }})">
                    <g class="sdc-wheel">
                        <path d="M-{{ sky.wheel }},0 A{{ sky.wheel }} {{ sky.wheel }} 0 0 1 {{ sky.wheel }},0 Z" fill="url(#sdc-night-fill)"/>
                        <path d="M-{{ sky.wheel }},0 A{{ sky.wheel }} {{ sky.wheel }} 0 0 0 {{ sky.wheel }},0 Z" fill="url(#sdc-day-fill)"/>
                        <circle class="sdc-wheel-ring" r="88"/>
                        <circle class="sdc-wheel-ring" r="58"/>
                        {{#each rays}}<polygon class="sdc-ray" points="{{ this }}"/>{{/each}}
                        {{#each nightStars}}<circle class="sdc-night-star" cx="{{ x }}" cy="{{ y }}" r="{{ r }}"/>{{/each}}
                        <circle class="sdc-wheel-rim" r="{{ sky.wheel }}"/>
                        {{#each ticks}}<polygon class="sdc-tick" points="{{ this }}"/>{{/each}}
                        <line class="sdc-wheel-axis" x1="-{{ sky.wheel }}" y1="0" x2="{{ sky.wheel }}" y2="0"/>
                    </g>
                </g>

                <path class="sdc-rim" d="{{ rimPath }}"/>
            </svg>
            <div class="sdc-moons"></div>
            <span class="sdc-location"></span>
            <i class="sdc-phase"></i>
        </div>
    </div>
</div>
